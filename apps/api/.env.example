# Environment
PORT=3333
NODE_ENV=development
APP_URL=http://localhost:3333

# Database
DATABASE_URL=mysql://root:root@localhost:3306/rabbit_hole

# Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# AWS S3 (or any S3-compatible provider)
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=rabbit-hole
AWS_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
AWS_ACCESS_KEY_ID=replace-with-your-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
